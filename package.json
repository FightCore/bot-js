{
  "name": "fightcore.bot",
  "version": "2.6.0",
  "description": "FightCore Discord bot to display frame data",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig-build.json",
    "start": "node --import dotenv/config ./build/index.js",
    "dev": "tsc -p tsconfig-build.json && node --import dotenv/config ./build/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FightCore/bot-js.git"
  },
  "keywords": [
    "melee",
    "frame",
    "data"
  ],
  "author": "FightCore",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FightCore/bot-js/issues"
  },
  "homepage": "https://github.com/FightCore/bot-js#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@datalust/winston-seq": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "inversify": "^7.11.0",
    "jaro-winkler-typescript": "^1.0.1",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}