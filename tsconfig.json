{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022"],
      "types": ["reflect-metadata"],
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "rootDir": "./",
      "outDir": "./build",
      "sourceMap": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true
    },
    "include": [
      "tests/**/*.test.ts",
      "tests/**.ts",
      "src/**/*.ts"
    ],
  }